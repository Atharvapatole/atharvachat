# ==============================================================================
# ATHARVA CHAT — PRODUCTION ENVIRONMENT VARIABLES (VERCEL DEPLOYMENT)
# Official Production Domain: https://atharvachat.vercel.app
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL CONFIGURATION
# ------------------------------------------------------------------------------
# Official canonical production URL
APP_URL=https://atharvachat.vercel.app
NEXT_PUBLIC_APP_URL=https://atharvachat.vercel.app

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (Client-side safe, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-only; bypasses RLS for webhooks and background processing)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte (64 hex characters) encryption key for AES-256-GCM token storage
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Campaign Cron trigger secret key
CRON_SECRET=atharva_cron_secret_production_key_32bytes

# ------------------------------------------------------------------------------
# 4. META WHATSAPP BUSINESS CLOUD API (VERCEL ENVIRONMENT FALLBACK / DIRECT)
# ------------------------------------------------------------------------------
# Meta App Secret (used for verifying X-Hub-Signature-256 in webhook payloads)
META_APP_SECRET=your_meta_app_secret_here

# WhatsApp Webhook Verification Token (entered in Meta App Dashboard Webhooks configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=atharva_chat_secure_webhook_verify_token_2026

# WhatsApp Cloud API Phone Number ID (from WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Permanent System User Access Token with whatsapp_business_messaging & whatsapp_business_management permissions
WHATSAPP_ACCESS_TOKEN=EAAB...your_system_user_access_token_here

# ------------------------------------------------------------------------------
# 5. OPENROUTER AI ENGINE (ATHARVA AI ASSISTANT)
# ------------------------------------------------------------------------------
# OpenRouter API Key for free-tier dynamic model discovery & autonomous messaging
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
