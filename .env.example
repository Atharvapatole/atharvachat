# ==============================================================================
# ATHARVA CHAT — WHATSAPP BUSINESS & AI ASSISTANT PLATFORM
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC VARIABLES (Exposed to the browser)
# ------------------------------------------------------------------------------
# Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Key (safe to expose, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The public canonical URL of your deployed application (used for webhooks and auth redirects)
# e.g., https://atharva-chat.vercel.app or http://localhost:3000 in development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (NEVER EXPOSE TO CLIENT / BROWSER)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - strictly for server-side webhooks & background sync)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AES-256-GCM Credential Encryption Key
# Generate a 32-byte hex string (64 hexadecimal characters):
# Example generator in node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OpenRouter API Key (Used to dynamically query models and generate Atharva AI responses)
# Get yours from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# WhatsApp Cloud API Default Webhook Verify Token (Optional fallback if not set in DB per user)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=atharva_chat_secure_verify_token_2026

# Cron Secret for securing background scheduled tasks (e.g., /api/cron/process-campaigns)
CRON_SECRET=atharva_campaign_cron_secret_key_123456
